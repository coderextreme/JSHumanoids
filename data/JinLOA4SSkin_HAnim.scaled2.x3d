            <Material diffuseColor='1 0 0' emissiveColor='1 0 0'/>
          </Appearance>
          <Sphere radius='0.007'/>
        </Shape>
      </Transform>
      <Transform DEF='JointLandmark'>
        <Shape DEF='HAnimJointLandmark'>
          <Appearance>
            <Material diffuseColor='0 0 1' emissiveColor='0 0 1'/>
          </Appearance>
          <Box size='0.016 0.016 0.016'/>
        </Shape>
      </Transform>
      <Transform DEF='JointShapeB'>
